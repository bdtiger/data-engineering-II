# Stage 1: Builder -- compile sl from source
FROM ubuntu:22.04 AS builder

RUN apt-get update
RUN apt-get install -y build-essential 
RUN apt-get install -y libncurses5-dev 
RUN apt-get install -y git

RUN git clone https://github.com/mtoyoda/sl.git /build/sl

WORKDIR /build/sl
RUN make

# Stage 2: Runtime -- copy only the binary
FROM ubuntu:22.04

RUN apt-get update
RUN apt-get install -y libncurses5
RUN rm -rf /var/lib/apt/lists/*

COPY --from=builder /build/sl/sl /usr/local/bin/sl

ENV PATH="${PATH}:/usr/local/bin/"

CMD ["echo", "Data Engineering-II."]